{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebpf-party-zh",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "../website/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "vars": {
    "ORIGIN": "http://127.0.0.1:8081",
    "MAX_PROGRAM_BYTES": "16384"
  }
}
